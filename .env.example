# Nusxa ko'chirib, .env deb nomlang va qiymatlarni to'ldiring

# SQLite ma'lumotlar bazasi (Docker'da absolute yo'l ishlatiladi)
DATABASE_URL="file:./prisma/dev.db"

# Admin JWT token imzosi — yangi qiymat generatsiya qiling:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="change-me"
